# =================================================================
# EventPulse - Nasarawa State University, Keffi (NSUK)
# Environment Configuration Template
# =================================================================

# -----------------------------------------------------------------
# 1. Application & Domain Settings
# -----------------------------------------------------------------
PORT=5173
NODE_ENV=development
VITE_APP_NAME="EventPulse NSUK"
VITE_APP_URL="http://localhost:5173"
VITE_UNIVERSITY_NAME="Nasarawa State University, Keffi"
VITE_UNIVERSITY_DOMAIN="nsuk.edu.ng"
VITE_DEFAULT_TIMEZONE="Africa/Lagos"

# -----------------------------------------------------------------
# 2. Database Configuration (Prisma / PostgreSQL / Supabase)
# -----------------------------------------------------------------
# For PostgreSQL / Supabase in production:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/eventpulse_db?schema=public"
# For local zero-config development:
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------
# 3. Authentication & Security Secrets
# -----------------------------------------------------------------
# Generate a 32+ character random secret for production sessions
JWT_SECRET="nsuk-eventpulse-jwt-super-secret-key-production-2026"
SESSION_COOKIE_NAME="nsuk_ep_session"

# Initial Bootstrap Administrator Account (Auto-seeded)
DEFAULT_ADMIN_EMAIL="admin@nsuk.edu.ng"
DEFAULT_ADMIN_PASSWORD="Admin123!"

# -----------------------------------------------------------------
# 4. Transactional Email Provider (Resend)
# -----------------------------------------------------------------
# Resend API Key in Vercel Environment Variables:
EVENTPULSE_MAILS_API_KEY=""
RESEND_API_KEY=""
EMAIL_PROVIDER="resend"
SMTP_FROM_NAME="EventPulse"
SMTP_FROM_EMAIL="support@eventpulse.com.ng"

# Authenticated SMTP Configuration (when using university mail server):
SMTP_HOST="smtp.nsuk.edu.ng"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@nsuk.edu.ng"
SMTP_PASS=""
SMTP_FROM_NAME="NSUK EventPulse"
SMTP_FROM_EMAIL="notifications@nsuk.edu.ng"

# Email Webhook Secret for signed delivery status & bounce tracking:
EMAIL_WEBHOOK_SECRET="whsec_nsuk_eventpulse_2026"

# -----------------------------------------------------------------
# 5. Background Notification Worker & Scheduler
# -----------------------------------------------------------------
# Shared secret for triggering scheduled reminder ticks (/api/cron/process-outbox)
CRON_SECRET="cron_secret_nsuk_scheduler_token_2026"

# Grace period in minutes to process missed reminder windows (default: 60)
REMINDER_GRACE_PERIOD_MINUTES=60
